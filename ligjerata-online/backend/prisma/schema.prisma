generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  password    String
  name        String
  role        String       @default("student")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  ligjeratat  Ligjerata[]
  enrollments Enrollment[]

  @@map("users")
}

model Ligjerata {
  id          Int          @id @default(autoincrement())
  titull      String
  pershkrim   String?
  videoUrl    String
  kategori    String       @default("Të tjera")
  profesorId  Int
  profesor    User         @relation(fields: [profesorId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  enrollments Enrollment[]

  @@map("ligjeratat")
}

model Enrollment {
  id          Int       @id @default(autoincrement())
  userId      Int
  ligjerataId Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ligjerata   Ligjerata @relation(fields: [ligjerataId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, ligjerataId])
  @@map("enrollments")
}